// SysML v2 textual grammar -- vertical-tracer slice.
//
// Covers, ported from the SysML v2 / KerML textual concrete syntax:
//
//   part def Engine;
//   part vehicleEngine : Engine;
//   package Vehicles { part def Engine; part e : Engine; package Inner { ... } }
//
// This is intentionally minimal. The grammar grows one construct at a time as
// the support matrix advances; it is layered (SysML extends KerML notation) and
// must track the normative BNF, not intuition.

start: package_body

package_body: member*

member: part_definition
      | part_usage
      | attribute_definition
      | attribute_usage
      | action_definition
      | action_usage
      | constraint_definition
      | constraint_usage
      | requirement_definition
      | requirement_usage
      | port_definition
      | port_usage
      | connection_definition
      | connection_usage
      | package_definition

// `part def <name> ;`
part_definition: "part" "def" NAME ";"

// `part <name> [ ":" <type> ] ;`
part_usage: "part" NAME (":" type_ref)? ";"

// `attribute def <name> ;`
attribute_definition: "attribute" "def" NAME ";"

// `attribute <name> [ ":" <type> ] ;`
attribute_usage: "attribute" NAME (":" type_ref)? ";"

// `action def <name> ;`
action_definition: "action" "def" NAME ";"

// `action <name> [ ":" <type> ] ;`
action_usage: "action" NAME (":" type_ref)? ";"

// `constraint def <name> ;`
constraint_definition: "constraint" "def" NAME ";"

// `constraint <name> [ ":" <type> ] ;`
constraint_usage: "constraint" NAME (":" type_ref)? ";"

// `requirement def <name> ;`
requirement_definition: "requirement" "def" NAME ";"

// `requirement <name> [ ":" <type> ] ;`
requirement_usage: "requirement" NAME (":" type_ref)? ";"

// `port def <name> ;`
port_definition: "port" "def" NAME ";"

// `port <name> [ ":" ["~"] <type> ] ;`
// `~<type>` types the port by the conjugate of the referenced PortDefinition
// (Phase 8a). The `~` is port-scoped: it is a distinct rule, not folded into the
// shared `type_ref`, so conjugation cannot leak onto non-port usages.
port_usage: "port" NAME (":" port_type_ref)? ";"
port_type_ref: CONJUGATE? type_ref
CONJUGATE: "~"

// `connection def <name> ;`
connection_definition: "connection" "def" NAME ";"

// `connection <name> [ ":" <type> ] [ "connect" <end> "to" <end> ] ;`
// Binary connector ends, non-chain references; n-ary/unnamed forms are later.
connection_usage: "connection" NAME (":" type_ref)? connect_clause? ";"

connect_clause: "connect" connection_end "to" connection_end
connection_end: qualified_name

// `package <name> { <members> }` (nestable) or `package <name> ;` (empty).
package_definition: "package" NAME "{" package_body "}"  -> package_definition
                  | "package" NAME ";"                    -> empty_package_definition

type_ref: qualified_name

qualified_name: NAME ("::" NAME)*

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT
%import common.WS
%ignore WS
