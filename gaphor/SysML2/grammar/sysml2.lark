// SysML v2 textual grammar -- vertical-tracer slice.
//
// Covers, ported from the SysML v2 / KerML textual concrete syntax:
//
//   part def Engine;
//   part vehicleEngine : Engine;
//   package Vehicles { part def Engine; part e : Engine; package Inner { ... } }
//
// This is intentionally minimal. The grammar grows one construct at a time as
// the support matrix advances; it is layered (SysML extends KerML notation) and
// must track the normative BNF, not intuition.

start: package_body

package_body: member*

member: part_definition
      | part_usage
      | attribute_definition
      | attribute_usage
      | action_definition
      | action_usage
      | constraint_definition
      | constraint_usage
      | requirement_definition
      | requirement_usage
      | port_definition
      | port_usage
      | connection_definition
      | connection_usage
      | interface_definition
      | interface_usage
      | package_definition

// A usage may carry a feature direction prefix (`in` / `out` / `inout`), which
// maps to KerML `Feature::direction` (Phase 8b). Definitions are Classifiers, not
// Features, so they take NO direction. The keyword is a distinct terminal so it
// is lexed as a direction only where a usage expects it (contextual LALR).
DIRECTION: "inout" | "in" | "out"

// `part def <name> ;`
part_definition: "part" "def" NAME ";"

// `[<dir>] part <name> [ ":" <type> ] ;`
part_usage: DIRECTION? "part" NAME (":" type_ref)? ";"

// `attribute def <name> ;`
attribute_definition: "attribute" "def" NAME ";"

// `[<dir>] attribute <name> [ ":" <type> ] ;`
attribute_usage: DIRECTION? "attribute" NAME (":" type_ref)? ";"

// `action def <name> ;`
action_definition: "action" "def" NAME ";"

// `[<dir>] action <name> [ ":" <type> ] ;`
action_usage: DIRECTION? "action" NAME (":" type_ref)? ";"

// `constraint def <name> ( ";" | "{" <body> "}" )`
constraint_definition: "constraint" "def" NAME (";" | constraint_body)

// `[<dir>] constraint <name> [ ":" <type> ] ( ";" | "{" <body> "}" )`
constraint_usage: DIRECTION? "constraint" NAME (":" type_ref)? (";" | constraint_body)

// A constraint body is opaque expression text in braces (Phase 6a): it is
// preserved as text, NOT parsed into a KerML expression tree. The terminal
// matches balanced braces (tolerant to nesting), so the body may itself contain
// `{ }` groups; deeper nesting than this is not supported.
constraint_body: CONSTRAINT_BODY
CONSTRAINT_BODY: /\{(?:[^{}]|\{(?:[^{}]|\{[^{}]*\})*\})*\}/

// `requirement def <name> ( ";" | "{" <clauses> "}" )`
requirement_definition: "requirement" "def" NAME (";" | requirement_body)

// `[<dir>] requirement <name> [ ":" <type> ] ( ";" | "{" <clauses> "}" )`
requirement_usage: DIRECTION? "requirement" NAME (":" type_ref)? (";" | requirement_body)

// A requirement body holds subject/assume/require clauses (Phase 6b). The
// assumed/required constraints reuse the opaque 6a constraint body; the subject is
// a (optionally typed) parameter feature.
requirement_body: "{" requirement_clause* "}"
requirement_clause: subject_clause | assume_clause | require_clause
subject_clause: "subject" NAME (":" type_ref)? ";"
assume_clause: "assume" "constraint" constraint_body
require_clause: "require" "constraint" constraint_body

// `port def <name> ;`
port_definition: "port" "def" NAME ";"

// `[<dir>] port <name> [ ":" ["~"] <type> ] ;`
// `~<type>` types the port by the conjugate of the referenced PortDefinition
// (Phase 8a). The `~` is port-scoped: it is a distinct rule, not folded into the
// shared `type_ref`, so conjugation cannot leak onto non-port usages.
port_usage: DIRECTION? "port" NAME (":" port_type_ref)? ";"
port_type_ref: CONJUGATE? type_ref
CONJUGATE: "~"

// `connection def <name> ;`
connection_definition: "connection" "def" NAME ";"

// `[<dir>] connection <name> [ ":" <type> ] [ "connect" <end> "to" <end> ] ;`
// Binary connector ends, non-chain references; n-ary/unnamed forms are later.
connection_usage: DIRECTION? "connection" NAME (":" type_ref)? connect_clause? ";"

connect_clause: "connect" connection_end "to" connection_end
connection_end: qualified_name

// `interface def <name> ;`
interface_definition: "interface" "def" NAME ";"

// `[<dir>] interface <name> [ ":" <type> ] [ "connect" <end> "to" <end> ] ;`
// InterfaceUsage IS a ConnectionUsage, so it reuses the binary connect ends
// (Phase 9) and the direction prefix (Phase 8b). Interface-end PORT bodies and
// flow are a later dependency (need definition-body grammar) -- Phase 8c is the
// connection-level surface only.
interface_usage: DIRECTION? "interface" NAME (":" type_ref)? connect_clause? ";"

// `package <name> { <members> }` (nestable) or `package <name> ;` (empty).
package_definition: "package" NAME "{" package_body "}"  -> package_definition
                  | "package" NAME ";"                    -> empty_package_definition

type_ref: qualified_name

qualified_name: NAME ("::" NAME)*

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT
%import common.WS
%ignore WS
