// SysML v2 textual grammar -- vertical-tracer slice.
//
// Covers, ported from the SysML v2 / KerML textual concrete syntax:
//
//   part def Engine;
//   part vehicleEngine : Engine;
//   package Vehicles { part def Engine; part e : Engine; package Inner { ... } }
//
// This is intentionally minimal. The grammar grows one construct at a time as
// the support matrix advances; it is layered (SysML extends KerML notation) and
// must track the normative BNF, not intuition.

start: package_body

package_body: member*

// Every member (and import) may carry a `public`/`private` visibility prefix
// (Phase 5a); the prefix is applied uniformly here so each member kind does not
// repeat it. An unmarked member defaults to PUBLIC (the SysML member default);
// an unmarked import defaults to PRIVATE (the KerML import default).
member: VISIBILITY? member_body
VISIBILITY: "public" | "private"

member_body: part_definition
      | part_usage
      | attribute_definition
      | attribute_usage
      | action_definition
      | action_usage
      | succession_usage
      | flow_usage
      | constraint_definition
      | constraint_usage
      | requirement_definition
      | requirement_usage
      | concern_definition
      | concern_usage
      | port_definition
      | port_usage
      | connection_definition
      | connection_usage
      | interface_definition
      | interface_usage
      | package_definition
      | import_statement

// `import <QName>;` (a named element) or `import <QName>::*;` (import-all: the
// public members of the namespace). `::*` is a single WILDCARD terminal so it does
// not collide with the `::` qualified-name separator (Phase 5a).
import_statement: "import" qualified_name WILDCARD? ";"
WILDCARD: /::\s*\*/

// A usage may carry a feature direction prefix (`in` / `out` / `inout`), which
// maps to KerML `Feature::direction` (Phase 8b). Definitions are Classifiers, not
// Features, so they take NO direction. The keyword is a distinct terminal so it
// is lexed as a direction only where a usage expects it (contextual LALR).
DIRECTION: "inout" | "in" | "out"

// `part def <name> ;`
part_definition: "part" "def" NAME ";"

// `[<dir>] part <name> [ ":" <type> ] ;`
part_usage: DIRECTION? "part" NAME (":" type_ref)? ";"

// `attribute def <name> ;`
attribute_definition: "attribute" "def" NAME ";"

// `[<dir>] attribute <name> [ ":" <type> ] ;`
attribute_usage: DIRECTION? "attribute" NAME (":" type_ref)? ";"

// `action def <name> ( ";" | "{" <body> "}" )` and
// `[<dir>] action <name> [ ":" <type> ] ( ";" | "{" <body> "}" )` (Phase 7).
// An action body holds nested members (steps + directed in/out parameters + other
// usages, owned as the action's FEATURES via FeatureMembership) plus successions
// and flows; it reuses the shared `member` list, so any nested usage kind works.
action_definition: "action" "def" NAME (";" | action_body)
action_usage: DIRECTION? "action" NAME (":" type_ref)? (";" | action_body)
action_body: "{" member* "}"

// Action control flow and item flow (Phase 7), as binary connector usages reusing
// the connector ends (`connection_end`). The explicit forms only:
//   `succession [<name>] first <end> then <end> ;`  -> SuccessionAsUsage
//   `flow [<name>] from <end> to <end> ;`           -> FlowUsage
// The chained `first/then`-only flow form, `flow def`, `of` payloads, and the
// advanced action nodes (if/for/fork/join/accept/send/assign) are out of scope.
succession_usage: "succession" NAME? "first" connection_end "then" connection_end ";"
flow_usage: "flow" NAME? "from" connection_end "to" connection_end ";"

// `constraint def <name> ( ";" | "{" <body> "}" )`
constraint_definition: "constraint" "def" NAME (";" | constraint_body)

// `[<dir>] constraint <name> [ ":" <type> ] ( ";" | "{" <body> "}" )`
constraint_usage: DIRECTION? "constraint" NAME (":" type_ref)? (";" | constraint_body)

// A constraint body is opaque expression text in braces (Phase 6a): it is
// preserved verbatim, NOT parsed into a KerML expression tree. It is built from
// literal `{` `}` plus a non-brace BODY_TEXT terminal (and arbitrarily nested
// `{ }` groups), so the body's `{`/`}` are the SAME tokens as every other brace
// in the grammar -- the PARSER decides "constraint body" vs "requirement body"
// (or package body) by context, with no greedy body terminal to mis-grab a brace.
// BODY_TEXT has a higher priority than WS so a whitespace-only body is preserved.
constraint_body: "{" body_element* "}"
body_element: BODY_TEXT | braced_text
braced_text: "{" body_element* "}"
BODY_TEXT.2: /[^{}]+/

// `requirement def [<reqId>] <name> ( ";" | "{" <clauses> "}" )`
requirement_definition: "requirement" "def" short_name? NAME (";" | requirement_body)

// `[<dir>] requirement [<reqId>] <name> [ ":" <type> ] ( ";" | "{" <clauses> "}" )`
requirement_usage: DIRECTION? "requirement" short_name? NAME (":" type_ref)? (";" | requirement_body)

// A requirement's `reqId` is its declaredShortName (Phase 6c), written as a KerML
// short name `<...>`: a quoted string `<'1.1.3'>` (for dotted/special ids) or a
// bare identifier `<R1>`. Inside the quotes, `\'` and `\\` are escapes (so a reqId
// may contain a quote or backslash and still round-trip); any other backslash use
// is rejected. Encoding/decoding lives in `shortnames.py`.
short_name: "<" (QUOTED_NAME | NAME) ">"
QUOTED_NAME: /'(?:[^'\\]|\\['\\])*'/

// A requirement body holds subject/assume/require (Phase 6b) and actor/stakeholder
// (Phase 6c) clauses. The assumed/required constraints reuse the opaque 6a
// constraint body; subject/actor/stakeholder are (optionally typed) parameters.
requirement_body: "{" requirement_clause* "}"
requirement_clause: subject_clause | assume_clause | require_clause
                  | actor_clause | stakeholder_clause | frame_clause
subject_clause: "subject" NAME (":" type_ref)? ";"
actor_clause: "actor" NAME (":" type_ref)? ";"
stakeholder_clause: "stakeholder" NAME (":" type_ref)? ";"
assume_clause: "assume" "constraint" constraint_body
require_clause: "require" "constraint" constraint_body
// A framed concern (Phase 6d), owned via a FramedConcernMembership (kind =
// requirement). Two forms, disambiguated by the `concern` keyword:
//   DECLARE (6d-1): `frame concern <name> [: <C>]` owns a NEW ConcernUsage;
//   REFERENCE (6d-2): `frame <existing>` owns an anonymous ConcernUsage that
//   REFERENCES the existing concern via a ReferenceSubsetting.
frame_clause: "frame" "concern" NAME (":" type_ref)? ";"  -> frame_declare
            | "frame" qualified_name ";"                  -> frame_reference

// The Concern construct (Phase 6d): a ConcernDefinition IS a RequirementDefinition
// and a ConcernUsage IS a RequirementUsage, so both reuse the requirement body
// (subject/assume/require/actor/stakeholder/frame).
concern_definition: "concern" "def" short_name? NAME (";" | requirement_body)
concern_usage: DIRECTION? "concern" short_name? NAME (":" type_ref)? (";" | requirement_body)

// `port def <name> ;`
port_definition: "port" "def" NAME ";"

// `[<dir>] port <name> [ ":" ["~"] <type> ] ;`
// `~<type>` types the port by the conjugate of the referenced PortDefinition
// (Phase 8a). The `~` is port-scoped: it is a distinct rule, not folded into the
// shared `type_ref`, so conjugation cannot leak onto non-port usages.
port_usage: DIRECTION? "port" NAME (":" port_type_ref)? ";"
port_type_ref: CONJUGATE? type_ref
CONJUGATE: "~"

// `connection def <name> ;`
connection_definition: "connection" "def" NAME ";"

// `[<dir>] connection <name> [ ":" <type> ] [ "connect" <end> "to" <end> ] ;`
// Binary connector ends, non-chain references; n-ary/unnamed forms are later.
connection_usage: DIRECTION? "connection" NAME (":" type_ref)? connect_clause? ";"

connect_clause: "connect" connection_end "to" connection_end
connection_end: qualified_name

// `interface def <name> ;`
interface_definition: "interface" "def" NAME ";"

// `[<dir>] interface <name> [ ":" <type> ] [ "connect" <end> "to" <end> ] ;`
// InterfaceUsage IS a ConnectionUsage, so it reuses the binary connect ends
// (Phase 9) and the direction prefix (Phase 8b). Interface-end PORT bodies and
// flow are a later dependency (need definition-body grammar) -- Phase 8c is the
// connection-level surface only.
interface_usage: DIRECTION? "interface" NAME (":" type_ref)? connect_clause? ";"

// `package <name> { <members> }` (nestable) or `package <name> ;` (empty).
package_definition: "package" NAME "{" package_body "}"  -> package_definition
                  | "package" NAME ";"                    -> empty_package_definition

type_ref: qualified_name

qualified_name: NAME ("::" NAME)*

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT
%import common.WS
%ignore WS
